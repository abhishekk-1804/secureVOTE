{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecureVOTE Election Export Archive",
  "description": "Schema for machine-verifiable election export archives generated by SecureVOTE.",
  "type": "object",
  "required": [
    "export_version",
    "exported_at",
    "export_hash",
    "election",
    "candidates",
    "devices",
    "ballots",
    "audit_log",
    "manifest"
  ],
  "properties": {
    "export_version": {
      "type": "string",
      "enum": ["1.0.0"],
      "description": "Specification version of the export envelope."
    },
    "exported_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of when the export archive was generated."
    },
    "export_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hex digest of the canonical JSON payload (excluding export_hash itself)."
    },
    "election": {
      "type": "object",
      "required": [
        "id",
        "name",
        "state",
        "configuration_hash",
        "total_ballots",
        "created_at"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "state": {
          "type": "string",
          "enum": ["CREATED", "CONFIGURED", "LOCKED", "OPEN", "SUSPENDED", "CLOSED", "PUBLISHED"]
        },
        "configuration_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "total_ballots": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "string", "format": "date-time" },
        "locked_at": { "type": ["string", "null"], "format": "date-time" },
        "opened_at": { "type": ["string", "null"], "format": "date-time" },
        "closed_at": { "type": ["string", "null"], "format": "date-time" },
        "published_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": true
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "position"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "party": { "type": ["string", "null"] },
          "symbol": { "type": ["string", "null"] },
          "position": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "last_sequence_number", "total_votes_cast"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "last_sequence_number": { "type": "integer", "minimum": 0 },
          "total_votes_cast": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "ballots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "session_id",
          "device_id",
          "candidate_id",
          "sequence_number",
          "ballot_hash",
          "recorded_at"
        ],
        "properties": {
          "id": { "type": "string" },
          "election_id": { "type": "string" },
          "session_id": { "type": "string" },
          "device_id": { "type": "string" },
          "candidate_id": { "type": "string" },
          "sequence_number": { "type": "integer", "minimum": 1 },
          "ballot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "recorded_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": true
      }
    },
    "audit_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sequence_number",
          "event_type",
          "timestamp",
          "entry_hash"
        ],
        "properties": {
          "id": { "type": ["integer", "string"] },
          "sequence_number": { "type": "integer", "minimum": 0 },
          "event_type": { "type": "string" },
          "event_data": { "type": ["string", "null"] },
          "actor": { "type": ["string", "null"] },
          "device_id": { "type": ["string", "null"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "previous_hash": { "type": ["string", "null"] },
          "entry_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": true
      }
    },
    "manifest": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "election_id": { "type": "string" },
        "total_ballots": { "type": "integer", "minimum": 0 },
        "candidate_totals": { "type": "string" },
        "device_totals": { "type": "string" },
        "reconciliation_status": { "type": "string" },
        "audit_chain_status": { "type": "string" },
        "configuration_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "digital_signature": { "type": ["string", "null"] },
        "generated_at": { "type": "string", "format": "date-time" },
        "verified_at": { "type": ["string", "null"], "format": "date-time" },
        "verified_by": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
