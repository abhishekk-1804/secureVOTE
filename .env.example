# SecureVOTE Backend Configuration
# Copy this to .env and edit values

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://securevote:securevote@localhost:5432/securevote

# For development without PostgreSQL, use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./securevote.db

# JWT Secret â€” CHANGE THIS in any non-local deployment
JWT_SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Signing key for election manifests and audit roots (backend-only)
# In production this would be an HSM-backed key; here it is a local PEM file.
SIGNING_KEY_PATH=./signing_key.pem

# Serial device (for Arduino connection, Phase 2+)
SERIAL_PORT=COM3
SERIAL_BAUD=9600

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
